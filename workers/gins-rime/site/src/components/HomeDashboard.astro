---
import { readFileSync } from 'fs'
import { join } from 'path'
import HomeStatusPanel from './HomeStatusPanel.tsx'

const REPO_ROOT = join(process.cwd(), '../../..')
function read(file: string): string {
  try { return readFileSync(join(REPO_ROOT, '.upstream', file), 'utf8').trim() }
  catch { return '—' }
}

const upstream = [
  {
    name: '万象词库',
    label: '词典数据版本',
    version: read('wanxiang.tag'),
    href: 'https://github.com/amzxyz/rime_wanxiang/releases',
  },
  {
    name: '万象模型',
    label: '拼音变换模型',
    version: read('wanxiang.tag'),
    href: 'https://github.com/amzxyz/rime_wanxiang/blob/main/wanxiang_algebra.yaml',
  },
  {
    name: '萌娘百科',
    label: '萌系词库',
    version: read('moetype.tag'),
    href: 'https://github.com/suiginko/moetype/releases',
  },
  {
    name: '英文混输',
    label: 'melt_eng 方案',
    version: read('rime-ice-melt.sha'),
    href: 'https://github.com/iDvel/rime-ice/commits/dev/melt_eng.schema.yaml',
  },
  {
    name: "Gin's zhwiki",
    label: '中文维基词库',
    version: read('zhwiki.month'),
    href: 'https://dumps.wikimedia.org/zhwiki/',
  },
]
---

<div class="home-dashboard">

  <p class="panel-label">上游版本</p>
  <div class="panel-grid">
    {upstream.map(s => (
      <a
        href={s.href}
        target="_blank"
        rel="noopener noreferrer"
        class="hp-card"
        aria-label={`${s.name} — ${s.version}`}
      >
        <span class="hp-name">{s.name}</span>
        <span class="hp-sub">{s.label}</span>
        <span class="hp-ver">{s.version}</span>
      </a>
    ))}
  </div>

  <p class="panel-label">词库 & 安装</p>
  <HomeStatusPanel client:load />

</div>

<style>
  .home-dashboard {
    margin: 2rem 0;
  }

  /* ── Section label ── */
  .panel-label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--sl-color-text) 40%, transparent);
    margin: 0 0 0.55rem;

    &:not(:first-child) {
      margin-top: 1.5rem;
    }
  }

  /* ── Shared 5-col grid ── */
  .panel-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.6rem;
  }

  @media (max-width: 780px) {
    .panel-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 480px) {
    .panel-grid { grid-template-columns: repeat(2, 1fr); }
  }

  /* ── Card base ── */
  .hp-card {
    display: flex;
    flex-direction: column;
    gap: 0.18rem;
    padding: 0.85rem 1rem;
    min-height: 5rem;
    border-radius: var(--sl-border-radius-sm, 8px);
    border: 1px solid var(--sl-color-hairline);
    background: color-mix(in srgb, var(--sl-color-accent) 4%, transparent);
    text-decoration: none;
    contain: layout style;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition:
      background 0.14s ease,
      border-color 0.14s ease,
      transform 0.12s ease,
      box-shadow 0.12s ease;
  }

  .hp-card:hover {
    background: color-mix(in srgb, var(--sl-color-accent) 11%, transparent);
    border-color: color-mix(in srgb, var(--sl-color-accent) 55%, transparent);
    transform: translateY(-1px);
    box-shadow: 0 4px 18px color-mix(in srgb, var(--sl-color-accent) 16%, transparent);
    will-change: transform;
  }

  .hp-card:active {
    transform: scale(0.96) translateY(0);
    box-shadow: none;
    background: color-mix(in srgb, var(--sl-color-accent) 16%, transparent);
    transition-duration: 0.06s;
  }

  .hp-card:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
    border-color: var(--sl-color-accent);
  }

  /* ── Card typography ── */
  .hp-name {
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--sl-color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hp-sub {
    font-size: 0.68rem;
    color: color-mix(in srgb, var(--sl-color-text) 42%, transparent);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .hp-ver {
    font-size: 0.78rem;
    font-family: var(--sl-font-mono);
    font-variant-numeric: tabular-nums;
    color: var(--sl-color-text-accent);
    margin-top: auto;
    padding-top: 0.45rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (prefers-reduced-motion: reduce) {
    .hp-card { transition: background 0.1s, border-color 0.1s; }
    .hp-card:hover, .hp-card:active { transform: none; box-shadow: none; }
  }
</style>
