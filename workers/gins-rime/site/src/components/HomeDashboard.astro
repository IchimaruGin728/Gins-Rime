---
import { readFileSync } from 'fs'
import { join } from 'path'
import HomeStatusPanel from './HomeStatusPanel.tsx'

const REPO_ROOT = join(process.cwd(), '../../..')
function read(file: string): string {
  try { return readFileSync(join(REPO_ROOT, '.upstream', file), 'utf8').trim() }
  catch { return '—' }
}

const upstream = [
  {
    name: '核心词库',
    label: '词典数据版本',
    version: read('core.tag'),
    href: 'https://github.com/amzxyz/rime_wanxiang/releases',
  },
  {
    name: '核心模型',
    label: '拼音变换模型',
    version: read('core.tag'),
    href: 'https://github.com/amzxyz/rime_wanxiang/blob/main/wanxiang_algebra.yaml',
  },
  {
    name: '萌娘百科',
    label: '二次元词汇',
    version: read('moetype.tag'),
    href: 'https://github.com/suiginko/moetype/releases',
  },
  {
    name: '英文混输',
    label: 'melt_eng 方案',
    version: read('rime-ice-melt.sha'),
    href: 'https://github.com/iDvel/rime-ice/commits/dev/melt_eng.schema.yaml',
  },
  {
    name: "Gin's zhwiki",
    label: '中文维基词库',
    version: read('zhwiki.month'),
    href: 'https://dumps.wikimedia.org/zhwiki/',
  },
]
---

<div class="my-8 space-y-8">
  <section class="space-y-3">
    <p class="section-label">
      上游版本
    </p>
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-5">
    {upstream.map(s => (
      <a
        href={s.href}
        target="_blank"
        rel="noopener noreferrer"
        class="surface-card-hover"
        aria-label={`${s.name} — ${s.version}`}
      >
        <span class="surface-title">{s.name}</span>
        <span class="surface-sub">{s.label}</span>
        <span class="mt-4 block surface-meta">{s.version}</span>
      </a>
    ))}
    </div>
  </section>

  <section class="space-y-3">
    <p class="section-label">
      词库 & 安装
    </p>
  <HomeStatusPanel
    dictVersions={{
      zhwiki:      read('zhwiki.month'),
      tone_moe:    read('moetype.tag'),
      'gins-shici': read('chinese-poetry.sha'),
    }}
    client:load
  />
  </section>
</div>
